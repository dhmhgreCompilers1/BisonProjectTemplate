Grammar

    0 $accept: expression_list $end

    1 expression_list: expression SEMICOLON
    2                | expression_list expression SEMICOLON
    3                | FUNCTION IDENTIFIER '(' param_list ')' '{' expression_list '}'
    4                | FUNCTION IDENTIFIER '(' ')' '{' expression_list '}'

    5 param_list: IDENTIFIER
    6           | param_list ',' IDENTIFIER

    7 expression: NUMBER
    8           | IDENTIFIER
    9           | '(' expression ')'
   10           | IDENTIFIER '(' ')'
   11           | IDENTIFIER '(' args ')'
   12           | expression '+' expression
   13           | expression '-' expression
   14           | expression '*' expression
   15           | expression '/' expression
   16           | expression '%' expression
   17           | '-' expression
   18           | '+' expression
   19           | expression FDIV expression
   20           | expression INCREMENT
   21           | expression DECREMENT
   22           | expression '^' expression
   23           | expression LAND expression
   24           | expression LOR expression
   25           | LNOT expression
   26           | expression EQ expression
   27           | expression NEQ expression
   28           | expression LT expression
   29           | expression LTE expression
   30           | expression GT expression
   31           | expression GTE expression
   32           | expression BITAND expression
   33           | expression BITOR expression
   34           | expression BITXOR expression
   35           | expression LSHIFT expression
   36           | expression RSHIFT expression
   37           | BNOT expression
   38           | IDENTIFIER '=' expression

   39 args: expression
   40     | args ',' expression


