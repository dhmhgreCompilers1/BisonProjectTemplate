Grammar

    0 $accept: compilation_unit $end

    1 compilation_unit: declarations statements
    2                 | statements
    3                 | declarations

    4 declarations: declaration
    5             | declarations declaration

    6 statements: statement
    7           | statements statement

    8 declaration: function_definition
    9            | variable_declaration

   10 function_definition: type_specifier IDENTIFIER '(' param_list ')' compound_statement
   11                    | type_specifier IDENTIFIER '(' ')' compound_statement

   12 param_list: IDENTIFIER
   13           | param_list ',' IDENTIFIER

   14 variable_declaration: type_specifier declarators SEMICOLON

   15 type_specifier: INT
   16               | FLOAT
   17               | VOID
   18               | CHAR

   19 declarators: direct_declarator
   20            | direct_declarator '=' expression
   21            | declarators ',' direct_declarator

   22 direct_declarator: IDENTIFIER
   23                  | direct_declarator '[' ']'

   24 statement: expression_statement
   25          | compound_statement
   26          | iteration_statement
   27          | selection_statement
   28          | jump_statement

   29 expression_statement: expression SEMICOLON
   30                     | SEMICOLON

   31 compound_statement: '{' statements '}'
   32                   | '{' '}'

   33 iteration_statement: WHILE '(' expression ')' statement
   34                    | FOR '(' expression_statement expression_statement expression ')' statement
   35                    | FOR '(' expression_statement expression_statement ')' statement
   36                    | DO statement WHILE '(' expression ')' SEMICOLON

   37 selection_statement: IF '(' expression ')' statement ELSE statement
   38                    | IF '(' expression ')' statement

   39 jump_statement: RETURN expression SEMICOLON
   40               | RETURN SEMICOLON
   41               | BREAK SEMICOLON
   42               | CONTINUE SEMICOLON

   43 expression: NUMBER
   44           | IDENTIFIER
   45           | '(' expression ')'
   46           | IDENTIFIER '(' ')'
   47           | IDENTIFIER '(' args ')'
   48           | expression '+' expression
   49           | expression '-' expression
   50           | expression '*' expression
   51           | expression '/' expression
   52           | expression '%' expression
   53           | '-' expression
   54           | '+' expression
   55           | expression FDIV expression
   56           | expression INCREMENT
   57           | expression DECREMENT
   58           | expression '^' expression
   59           | expression LAND expression
   60           | expression LOR expression
   61           | LNOT expression
   62           | expression EQ expression
   63           | expression NEQ expression
   64           | expression LT expression
   65           | expression LTE expression
   66           | expression GT expression
   67           | expression GTE expression
   68           | expression BITAND expression
   69           | expression BITOR expression
   70           | expression BITXOR expression
   71           | expression LSHIFT expression
   72           | expression RSHIFT expression
   73           | BNOT expression
   74           | IDENTIFIER '=' expression

   75 args: expression
   76     | args ',' expression


