    '}' (125) 3 4
    error (256)
    NUMBER <node> (258) 7
    IDENTIFIER <node> (259) 3 4 5 6 8 10 11 38
    SEMICOLON (260) 1 2
    FUNCTION (261) 3 4
    LOR (262) 24
    LAND (263) 23
